{
  "id": "DOI2v5rYkrf158ZH",
  "name": "Almutawa - Personal Gmail Finance Watcher",
  "description": "Every 15 minutes: finds likely bank/payment emails in personal Gmail, reads them as clean text and sends them to Finance Intake (which ignores non-transactions), then marks them scanned.",
  "active": true,
  "activeVersionId": "7801ef1b-ef2c-4fc9-8e86-2c362a43ad3a",
  "createdAt": "2026-10-04T04:25:56.155Z",
  "updatedAt": "2026-10-04T04:26:56.029Z",
  "isArchived": false,
  "versionId": "7801ef1b-ef2c-4fc9-8e86-2c362a43ad3a",
  "versionCounter": 3,
  "sourceWorkflowId": null,
  "triggerCount": 1,
  "nodes": [
    {
      "id": "eb39e562-d155-42fe-afd1-2df618d9a4f6",
      "name": "Every 15 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      }
    },
    {
      "id": "4191e2ab-5f0c-40fb-8079-205271afe860",
      "name": "Search Bank Emails",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        224,
        0
      ],
      "parameters": {
        "resource": "message",
        "operation": "getAll",
        "returnAll": false,
        "limit": 25,
        "simple": true,
        "filters": {
          "q": "newer_than:2d -category:promotions -category:social (debit OR credit OR transaction OR purchase OR transfer OR payment OR card OR BHD OR \"BD \" OR تحويل OR خصم OR إيداع OR مبلغ OR شراء OR دفع)",
          "readStatus": "both"
        }
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "GhXbtHoEb5eO8ZiQ",
          "name": "Gmail account"
        }
      },
      "alwaysOutputData": true,
      "webhookId": "a756e767-2be0-4574-971a-643540f50062"
    },
    {
      "id": "1f4317d6-9737-4fe4-af3e-c828579dab2a",
      "name": "Collect Ids",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const ids = $input.all().map(function (i) { return i.json && i.json.id; }).filter(Boolean);\nreturn [{ json: { ids: JSON.stringify(ids.map(function (x) { return 'gmail_' + x; })) } }];"
      }
    },
    {
      "id": "7614779a-75ba-4b72-a4a5-6b7fe0863fd2",
      "name": "Filter Already Scanned",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        672,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT coalesce(json_agg(x.id), '[]'::json) AS new_ids FROM jsonb_array_elements_text($1::jsonb) AS x(id) WHERE NOT EXISTS (SELECT 1 FROM processed_emails p WHERE p.message_id = x.id)",
        "options": {
          "queryReplacement": "={{ [ $json.ids ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "2k1Ti2SitOd5gAN3",
          "name": "Postgres account"
        }
      }
    },
    {
      "id": "13ca1af4-39cd-441f-886b-796f4f242f54",
      "name": "New Email Items",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const fresh = new Set($('Filter Already Scanned').first().json.new_ids || []);\nreturn $('Search Bank Emails').all().map(function (i) { return i.json || {}; }).filter(function (m) { return m.id && fresh.has('gmail_' + m.id); }).slice(0, 15).map(function (m) { return { json: { id: m.id, from: m.From || m.from || '', subject: m.Subject || m.subject || '' } }; });"
      }
    },
    {
      "id": "469241a8-af72-4bb1-a5ea-c3fd5b65b37d",
      "name": "Read Email Text",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
