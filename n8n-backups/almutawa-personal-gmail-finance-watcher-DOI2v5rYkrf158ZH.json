      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO processed_emails (message_id, sender, subject, category, importance, action_taken) VALUES ($1, $2, $3, 'finance_scan', 'low', 'sent to finance intake') ON CONFLICT (message_id) DO UPDATE SET processed_at = processed_emails.processed_at RETURNING message_id",
        "options": {
          "queryReplacement": "={{ [ 'gmail_' + $('New Email Items').item.json.id, $('New Email Items').item.json.from, $('New Email Items').item.json.subject ] }}",
