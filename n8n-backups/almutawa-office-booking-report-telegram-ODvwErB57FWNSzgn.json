      "id": "03d2fcda-d484-48fd-849f-3a7172930558",
      "name": "Is Booking Report?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        224,
        112
      ],
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ !$json.message.from.is_bot && ( ($json.message.text || '').indexOf('سجل حجز') === 0 || ($json.message.text || '').indexOf('/حجز') === 0 || ($json.message.text || '').toLowerCase().indexOf('/booking') === 0 || ($json.message.text || '').toLowerCase().indexOf('/newbooking') === 0 || ($json.message.reply_to_message && $json.message.reply_to_message.from && $json.message.reply_to_message.from.is_bot) ) }}",
              "operator": {
                "operation": "equals",
                "type": "boolean"
              },
              "rightValue": true
            }
          ],
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          }
        }
