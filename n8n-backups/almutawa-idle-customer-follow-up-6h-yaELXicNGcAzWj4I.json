{
  "id": "yaELXicNGcAzWj4I",
  "name": "Almutawa - Idle Customer Follow-up (6h)",
  "description": "Hourly job that scans inbound WhatsApp messages, finds customers whose most recent message was sent 6-7 hours ago with no reply from them since, and posts a summary to the office Telegram group as a nudge for personal follow-up.",
  "active": true,
  "activeVersionId": "da373af0-9202-4512-9f0e-b067419d79de",
  "createdAt": "2026-09-16T19:35:26.294Z",
  "updatedAt": "2026-09-29T20:16:48.414Z",
  "isArchived": false,
  "versionId": "da373af0-9202-4512-9f0e-b067419d79de",
  "versionCounter": 8,
  "sourceWorkflowId": null,
  "triggerCount": 1,
  "nodes": [
    {
      "id": "02a751d4-24d0-464d-a2a4-4d3275629dbc",
      "name": "Every Hour",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.4,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      }
    },
    {
      "id": "ae70b1fa-fd21-4b32-b2d8-66954e3e1601",
      "name": "Find Customers Idle 6h+",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const items = $input.all();\nconst now = new Date();\nconst latestByPhone = {};\nfor (const it of items) {\n  const f = it.json;\n  const phone = f.customer_phone;\n  const ts = f.timestamp;\n  if (!phone || !ts) continue;\n  if (!latestByPhone[phone] || new Date(ts) > new Date(latestByPhone[phone].timestamp)) {\n    latestByPhone[phone] = f;\n  }\n}\nconst results = [];\nfor (const phone in latestByPhone) {\n  const rec = latestByPhone[phone];\n  const ts = new Date(rec.timestamp);\n  const hours = (now - ts) / 3600000;\n  if (hours >= 6 && hours < 7) {\n    results.push({ json: { phone: phone, message: rec.body || '', timestamp: rec.timestamp } });\n  }\n}\nreturn results;"
      }
    },
    {
      "id": "e2a1dce3-4fcc-4e1f-9323-27fb944da888",
      "name": "Send Idle Customer Summary",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        672,
        0
      ],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "-1004357436155",
        "text": "=⏰ *عميل ساكت منذ 6 ساعات*\nرقم الهاتف: {{ $('Parse Classification').item.json.phone }}\nاسم العميل: {{ $json.full_name || 'غير معروف' }}\n\n📝 ملخص المحادثة:\n{{ $json.notes || ('آخر رسالة: ' + $('Parse Classification').item.json.message) }}\n\nقد يستاهل متابعة شخصية معه.",
        "additionalFields": {
          "appendAttribution": false,
          "parse_mode": "HTML"
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "QfQTvpw3XcVYjBNy",
          "name": "Telegram account"
        }
      },
      "webhookId": "9a36a5fb-8210-48af-90f6-a804f5d72cef"
    },
    {
      "id": "f1eba9c5-29cd-4e52-b6fe-f4a062609aa7",
      "name": "Classify Message Intent",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.3,
      "position": [
        448,
        -120
      ],
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o-mini"
        },
        "operation": "response",
        "options": {
          "maxTokens": 60
        },
        "resource": "text",
        "responses": {
          "values": [
            {
              "content": "=رسالة العميل الأخيرة: \"{{ $json.message }}\"\n\nحلل هذي الرسالة وجاوب بصيغة JSON فقط بدون أي نص إضافي: {\"needs_followup\": true او false}.\nneeds_followup تكون true فقط إذا كانت الرسالة تمثل استفسار جدي عن رحلة، باقة، فندق، طيران، أو حجز يحتاج متابعة بشرية.\nتكون false إذا كانت مجرد تحية صباحية/مسائية، دعاء، تهنئة، شكر، او رسالة يومية عامة بدون طلب فعلي (عادة بحرينية شائعة يرسلها البعض يوميًا للأرقام التجارية والشخصية بدون تمييز).",
              "role": "user",
              "type": "text"
            }
          ]
        },
        "simplify": true
      },
      "credentials": {
        "openAiApi": {
          "id": "xEhei2uTKNn8yPj5",
          "name": "OpenAI account"
        }
      }
    },
    {
      "id": "99c3b743-e619-46ee-8cee-b017efa13c83",
      "name": "Parse Classification",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        -120
      ],
      "parameters": {
        "jsCode": "const raw = $input.item.json;\nconst text = raw.content || raw.output_text || raw.text || JSON.stringify(raw);\nlet parsed = { needs_followup: true };\ntry {\n  const match = String(text).match(/\\{[\\s\\S]*\\}/);\n  if (match) parsed = JSON.parse(match[0]);\n} catch (e) {}\nconst orig = $('Find Customers Idle 6h+').item.json;\nreturn { json: { phone: orig.phone, message: orig.message, timestamp: orig.timestamp, needsFollowup: !!parsed.needs_followup } };",
        "language": "javaScript",
        "mode": "runOnceForEachItem"
      }
    },
    {
      "id": "889c66cf-bcfc-4ec1-9937-f2785ca28eb2",
      "name": "Needs Follow-up?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        896,
        -120
      ],
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.needsFollowup }}",
              "operator": {
                "operation": "equals",
                "type": "boolean"
              },
              "rightValue": true
            }
          ],
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          }
        }
      }
    },
    {
      "id": "c9fc5cce-167b-427c-9260-369e436ebcf8",
      "name": "Fetch Inbound Messages (48h)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        224,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT customer_phone, body, timestamp FROM messages WHERE direction = 'Inbound' AND timestamp > now() - interval '48 hours' ORDER BY timestamp DESC;"
      },
      "credentials": {
        "postgres": {
          "id": "2k1Ti2SitOd5gAN3",
          "name": "Postgres account"
        }
      }
    },
    {
      "id": "0aec457f-8b54-44ae-956e-20141f4d31e9",
      "name": "Get Customer Profile",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        660,
        112
      ],
      "parameters": {
        "operation": "executeQuery",
        "options": {
          "queryReplacement": "={{ [$json.phone] }}"
        },
        "query": "SELECT full_name, notes FROM customers WHERE phone = $1;"
      },
      "credentials": {
        "postgres": {
          "id": "2k1Ti2SitOd5gAN3",
          "name": "Postgres account"
        }
      }
    }
  ],
