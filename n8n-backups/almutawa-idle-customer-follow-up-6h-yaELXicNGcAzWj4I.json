    {
      "id": "f1eba9c5-29cd-4e52-b6fe-f4a062609aa7",
      "name": "Classify Message Intent",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.3,
      "position": [
        448,
        -120
      ],
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o-mini"
        },
        "operation": "response",
        "options": {
          "maxTokens": 60
        },
        "resource": "text",
        "responses": {
          "values": [
            {
              "content": "=رسالة العميل الأخيرة: \"{{ $json.message }}\"\n\nحلل هذي الرسالة وجاوب بصيغة JSON فقط بدون أي نص إضافي: {\"needs_followup\": true او false}.\nneeds_followup تكون true فقط إذا كانت الرسالة تمثل استفسار جدي عن رحلة، باقة، فندق، طيران، أو حجز يحتاج متابعة بشرية.\nتكون false إذا كانت مجرد تحية صباحية/مسائية، دعاء، تهنئة، شكر، او رسالة يومية عامة بدون طلب فعلي (عادة بحرينية شائعة يرسلها البعض يوميًا للأرقام التجارية والشخصية بدون تمييز).",
              "role": "user",
              "type": "text"
            }
          ]
        },
        "simplify": true
      },
      "credentials": {
        "openAiApi": {
          "id": "xEhei2uTKNn8yPj5",
          "name": "OpenAI account"
        }
      }
    },
    {
      "id": "99c3b743-e619-46ee-8cee-b017efa13c83",
      "name": "Parse Classification",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        -120
      ],
      "parameters": {
        "jsCode": "const raw = $input.item.json;\nconst text = raw.content || raw.output_text || raw.text || JSON.stringify(raw);\nlet parsed = { needs_followup: true };\ntry {\n  const match = String(text).match(/\\{[\\s\\S]*\\}/);\n  if (match) parsed = JSON.parse(match[0]);\n} catch (e) {}\nconst orig = $('Find Customers Idle 6h+').item.json;\nreturn { json: { phone: orig.phone, message: orig.message, timestamp: orig.timestamp, customerId: orig.customerId, needsFollowup: !!parsed.needs_followup } };",
        "language": "javaScript",
        "mode": "runOnceForEachItem"
      }
    },
