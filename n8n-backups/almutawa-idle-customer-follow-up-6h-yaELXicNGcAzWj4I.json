{
  "id": "yaELXicNGcAzWj4I",
  "name": "Almutawa - Idle Customer Follow-up (6h)",
  "description": "Hourly job that scans inbound WhatsApp messages, finds customers whose most recent message was sent 6-7 hours ago with no reply from them since, and posts a summary to the office Telegram group as a nudge for personal follow-up.",
  "active": true,
  "activeVersionId": "1bdab95c-0f69-4ebd-9f84-02d0914862ae",
  "createdAt": "2026-09-16T19:35:26.294Z",
  "updatedAt": "2026-09-17T05:15:52.385Z",
  "isArchived": false,
  "versionId": "1bdab95c-0f69-4ebd-9f84-02d0914862ae",
  "versionCounter": 3,
  "sourceWorkflowId": null,
  "triggerCount": 1,
  "nodes": [
    {
      "id": "02a751d4-24d0-464d-a2a4-4d3275629dbc",
      "name": "Every Hour",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.4,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      }
    },
    {
      "id": "da465054-73af-4c58-92a9-3cb2e1c0062e",
      "name": "Fetch Inbound Messages (48h)",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.2,
      "position": [
        224,
        0
      ],
      "parameters": {
        "resource": "record",
        "operation": "search",
        "base": {
          "__rl": true,
          "mode": "id",
          "value": "appPB4D3VkkSJKjRK",
          "cachedResultName": "ALMUTAWA Tourism CRM"
        },
        "table": {
          "__rl": true,
          "mode": "id",
          "value": "tblMrAwnefYntNtUH",
          "cachedResultName": "Messages"
        },
        "filterByFormula": "={{ 'AND({Direction}=\"Inbound\", IS_AFTER({Timestamp}, DATEADD(NOW(), -48, \"hours\")))' }}",
        "returnAll": true,
        "sort": {
          "property": [
            {
              "field": "Timestamp",
              "direction": "desc"
            }
          ]
        }
      },
      "credentials": {
        "airtableTokenApi": {
          "id": "dJPlPtRxY8Txd9y9",
          "name": "Airtable Personal Access Token account"
        }
      }
    },
    {
      "id": "ae70b1fa-fd21-4b32-b2d8-66954e3e1601",
      "name": "Find Customers Idle 6h+",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const items = $input.all();\nconst now = new Date();\nconst latestByPhone = {};\nfor (const it of items) {\n  const f = it.json.fields || {};\n  const phone = f[\"Phone\"];\n  const ts = f[\"Timestamp\"];\n  if (!phone || !ts) continue;\n  if (!latestByPhone[phone] || new Date(ts) > new Date(latestByPhone[phone].fields.Timestamp)) {\n    latestByPhone[phone] = it.json;\n  }\n}\nconst results = [];\nfor (const phone in latestByPhone) {\n  const rec = latestByPhone[phone];\n  const ts = new Date(rec.fields[\"Timestamp\"]);\n  const hours = (now - ts) / 3600000;\n  if (hours >= 6 && hours < 7) {\n    const customerLinks = rec.fields[\"Customer\"] || [];\n    results.push({ json: { phone: phone, message: rec.fields[\"Message Content\"] || \"\", timestamp: rec.fields[\"Timestamp\"], customerId: customerLinks[0] || \"\" } });\n  }\n}\nreturn results;"
      }
    },
    {
