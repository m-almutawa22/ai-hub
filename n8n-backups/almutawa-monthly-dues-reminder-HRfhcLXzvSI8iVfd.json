{
  "id": "HRfhcLXzvSI8iVfd",
  "name": "Almutawa - Monthly Dues Reminder",
  "description": "Every day at 8 AM Bahrain: for monthly commitments due within 3 days (or overdue) and not yet paid this month, creates a payment task (shown in tasks and calendar) and reminds the owner.",
  "active": true,
  "activeVersionId": "856ed842-5e24-42a1-903b-75cc75c329f7",
  "createdAt": "2026-10-04T04:28:17.584Z",
  "updatedAt": "2026-10-04T04:28:24.490Z",
  "isArchived": false,
  "versionId": "856ed842-5e24-42a1-903b-75cc75c329f7",
  "versionCounter": 2,
  "sourceWorkflowId": null,
  "triggerCount": 1,
  "nodes": [
    {
      "id": "b38cdfc7-b0a1-49f8-b466-413ea0073222",
      "name": "Every Day 8 AM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 8,
              "triggerAtMinute": 0
            }
          ]
        }
      }
    },
    {
      "id": "b3c89274-539b-4b04-97e3-bbcdf07cfcf5",
      "name": "Create Due Payment Tasks",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        224,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH today AS (SELECT (now() AT TIME ZONE 'Asia/Bahrain')::date AS d), due AS (SELECT c.id, c.title, c.amount, c.currency, c.counterparty, c.scope, make_date(extract(year FROM t.d)::int, extract(month FROM t.d)::int, LEAST(c.due_day, 28)) AS due_date FROM recurring_commitments c, today t WHERE c.active AND c.frequency = 'monthly' AND c.due_day IS NOT NULL AND (c.last_paid_at IS NULL OR c.last_paid_at < date_trunc('month', now() AT TIME ZONE 'Asia/Bahrain'))), sel AS (SELECT due.* FROM due, today WHERE due.due_date <= today.d + 3 AND NOT EXISTS (SELECT 1 FROM tasks k WHERE k.related_entity = 'commitment' AND k.related_id = due.id::text AND k.created_at >= date_trunc('month', now() AT TIME ZONE 'Asia/Bahrain'))), ins AS (INSERT INTO tasks (title, description, status, priority, assigned_to, created_by, due_at, related_entity, related_id, received_at, estimated_minutes, plan, source) SELECT 'دفع: ' || title, trim(coalesce(counterparty, '') || ' ' || coalesce(amount::text || ' ' || currency, '') || CASE WHEN scope = 'office' THEN ' (المكتب)' ELSE ' (شخصي)' END), 'open', 'high', 'mohamed', 'finance_assistant', (due_date + time '09:00') AT TIME ZONE 'Asia/Bahrain', 'commitment', id::text, now(), 10, '1. ادفع المبلغ.\n2. قول للوكيل إنك دفعت أو صنّف حركة البنك لما توصل، فيتسجل الالتزام كمدفوع.', 'finance' FROM sel RETURNING id, title, description, to_char(due_at AT TIME ZONE 'Asia/Bahrain', 'YYYY-MM-DD') AS due) SELECT * FROM ins"
      },
      "credentials": {
        "postgres": {
          "id": "2k1Ti2SitOd5gAN3",
          "name": "Postgres account"
        }
      }
    },
