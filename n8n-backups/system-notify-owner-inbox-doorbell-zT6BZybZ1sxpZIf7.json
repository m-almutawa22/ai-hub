{
  "id": "zT6BZybZ1sxpZIf7",
  "name": "System - Notify Owner (Inbox + Doorbell)",
  "description": "Shared helper: any workflow calls it to put a notification in the agent page inbox; for non-low priority it also sends a one-line Telegram doorbell with the inbox link.",
