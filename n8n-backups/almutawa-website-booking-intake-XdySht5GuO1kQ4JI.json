    {
      "id": "779b63f2-d27a-44c1-b34f-aa4ace982851",
      "name": "Prepare Traveler Items",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        220
      ],
      "parameters": {
        "jsCode": "const body = $('Website Booking Intake').first().json.body || {};\nconst bookingId = $('Create Website Booking').first().json.id;\nconst travelers = Array.isArray(body.travelerDetails) ? body.travelerDetails : [];\nif (!bookingId || !travelers.length) return [];\nreturn travelers.map(function(t, idx){\n  var first = t.firstName || '';\n  var last = t.lastName || '';\n  var full = (first || last) ? (first + ' ' + last).trim() : (t.name || t.fullName || '');\n  return { json: {\n    fullName: full,\n    title: t.title || '',\n    dob: t.dob || '',\n    nationality: t.nationality || '',\n    passportNumber: t.passportNumber || '',\n    role: idx === 0 ? 'Primary' : 'Companion',\n    bookingId: bookingId,\n    passportPhotoDataUrl: t.passportPhotoDataUrl || ''\n  } };\n});",
        "language": "javaScript",
        "mode": "runOnceForAllItems"
      }
    },
