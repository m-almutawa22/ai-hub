      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const pkg = $input.first().json;\nconst travelers = Number($(\"Website Booking Intake\").first().json.body.travelers) || 1;\nconst current = Number(pkg.fields[\"Seats Available\"]) || 0;\nconst remaining = Math.max(current - travelers, 0);\nreturn [{ json: { packageId: pkg.id, packageTitle: pkg.fields[\"Title\"], remaining: remaining, travelers: travelers } }];"
      }
