            "title": "={{ $json.ok === 'true' ? '✅ انرسل الرد: ' + $json.subject : '❌ تعذر إرسال الرد: ' + $json.subject }}",
            "body": "={{ $json.ok === 'true' ? 'تم إرسال الرد اللي وافقت عليه من إيميل المكتب.' : 'صار خطأ أثناء الإرسال، راجع الطلب في الموافقات أو اطلب من الوكيل يعيد المحاولة.' }}",
            "priority": "={{ $json.ok === 'true' ? 'low' : 'high' }}",
            "entity": "approvals",
