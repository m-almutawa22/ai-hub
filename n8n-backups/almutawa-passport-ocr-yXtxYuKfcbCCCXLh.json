  "nodes": [
    {
      "id": "f09d44c2-869e-4d95-8c5b-7951375514ce",
      "name": "Passport OCR API",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "passport-ocr",
        "authentication": "none",
        "responseMode": "lastNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "webhookId": "3b2a49b6-d80b-4a16-87d2-98c8449ff9f6"
    },
    {
      "id": "35dc4702-3bbb-4a03-afb1-4c438afba099",
      "name": "Analyze Passport Image",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.3,
      "position": [
        224,
        0
      ],
      "parameters": {
        "resource": "image",
        "operation": "analyze",
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o",
          "cachedResultName": "gpt-4o"
        },
        "text": "This is a photo of a passport photo page. Read the printed personal details carefully and extract: 1) the holder full name exactly as printed in the Latin/English alphabet (if the passport shows a name in Arabic or another script alongside a Latin transliteration, use the Latin transliteration), 2) the passport number. Respond with ONLY a raw JSON object, no markdown, no explanation, in the exact shape {\"fullName\": \"...\", \"passportNumber\": \"...\"}. If a field is not clearly readable, use an empty string for that field.",
        "inputType": "url",
        "imageUrls": "={{ $json.body.imageDataUrl }}",
        "simplify": true,
        "options": {
          "detail": "high",
          "maxTokens": 300
        }
      },
      "credentials": {
        "openAiApi": {
          "id": "xEhei2uTKNn8yPj5",
          "name": "OpenAI account"
        }
      }
    },
    {
      "id": "bab7a8d8-b1af-4a12-bf41-f13fd201b2a0",
      "name": "Parse OCR Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const raw = $input.first().json;\nconst text = raw.content || raw.output || raw.text || JSON.stringify(raw);\nlet parsed = null;\ntry {\n  const match = String(text).match(/\\{[\\s\\S]*\\}/);\n  if (match) parsed = JSON.parse(match[0]);\n} catch (e) {}\nif (!parsed) return [{ json: { success: false, error: 'parse_failed' } }];\nreturn [{ json: { success: true, fullName: parsed.fullName || '', passportNumber: parsed.passportNumber || '' } }];"
      }
    }
  ],
  "connections": {
    "Passport OCR API": {
      "main": [
        [
          {
            "node": "Analyze Passport Image",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Analyze Passport Image": {
      "main": [
        [
          {
            "node": "Parse OCR Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
