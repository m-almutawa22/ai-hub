    {
      "id": "63407b07-309f-4023-8df4-7273db850797",
      "name": "Build Backup File",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        192
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const wf = $input.item.json;\nconst safeName = String(wf.name || \"workflow\").toLowerCase().replace(/[^a-z0-9]+/g, \"-\").replace(/(^-|-$)/g, \"\");\nconst filePath = \"n8n-backups/\" + safeName + \"-\" + wf.id + \".json\";\nlet fileContent = JSON.stringify(wf, null, 2);\n// Redact literal secret-like values so GitHub's secret scanning doesn't block the backup commit.\nfileContent = fileContent.replace(/AC[a-f0-9]{32}/gi, \"[REDACTED_TWILIO_ACCOUNT_SID]\");\nfileContent = fileContent.replace(/SK[a-f0-9]{32}/gi, \"[REDACTED_TWILIO_API_KEY]\");\nfileContent = fileContent.replace(/sk-[A-Za-z0-9_-]{20,}/g, \"[REDACTED_API_KEY]\");\nfileContent = fileContent.replace(/pat[A-Za-z0-9]{14}\\.[A-Za-z0-9]{40,}/g, \"[REDACTED_AIRTABLE_TOKEN]\");\nconst commitMessage = \"Auto backup: \" + wf.name + \" (\" + wf.id + \") - \" + new Date().toISOString();\nreturn { json: { filePath: filePath, fileContent: fileContent, commitMessage: commitMessage, workflowName: wf.name } };"
      }
    },
    {
      "id": "fbc470dc-ae79-4154-9afa-8e11a82599f8",
      "name": "Update Backup File",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1.1,
      "position": [
        1344,
        272
      ],
      "parameters": {
        "resource": "file",
        "operation": "edit",
        "owner": {
          "__rl": true,
          "mode": "name",
          "value": "m-almutawa22"
        },
        "repository": {
          "__rl": true,
          "mode": "name",
          "value": "ai-hub"
        },
        "filePath": "={{ $json.filePath }}",
        "fileContent": "={{ $json.fileContent }}",
        "commitMessage": "={{ $json.commitMessage }}"
      },
      "credentials": {
        "githubApi": {
          "id": "JcspQmaBsDM50abz",
          "name": "GitHub account"
        }
      },
      "onError": "continueErrorOutput",
      "webhookId": "46a05696-94e4-4693-8040-dfeec65951b7"
    },
