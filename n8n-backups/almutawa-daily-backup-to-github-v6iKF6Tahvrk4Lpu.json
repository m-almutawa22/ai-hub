          "name": "Header Auth account"
        }
      }
    },
    {
      "id": "05aa530e-9e94-4075-9f29-61422ca3d636",
      "name": "Extract Workflow List",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        272
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const items = $input.first().json.data || [];\nreturn items.map(function(wf) { return { json: { id: wf.id, name: wf.name, active: wf.active } }; });"
      }
    },
    {
      "id": "1040d574-1bf9-4e8a-88b6-f27de6341000",
      "name": "Send Backup Summary",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        896,
        0
      ],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "-1004357436155",
        "text": "=Daily backup completed.\nAll workflows exported to GitHub (m-almutawa22/ai-hub).\nTime: {{ $now.toFormat(\"yyyy-MM-dd HH:mm\") }}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "QfQTvpw3XcVYjBNy",
          "name": "Telegram account"
        }
      },
      "executeOnce": true,
      "webhookId": "e34e60bb-e474-4451-876b-e8c728a49dd0"
    },
    {
      "id": "045bdd00-8581-4617-bbf3-7eb6a75bb037",
      "name": "Get Workflow Full Details",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        896,
        192
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://n8n-production-47b1.up.railway.app/api/v1/workflows/{{ $json.id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        },
        "options": {}
      },
      "credentials": {
