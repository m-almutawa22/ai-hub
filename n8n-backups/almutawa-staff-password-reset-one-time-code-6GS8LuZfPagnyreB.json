      "typeVersion": 2.2,
      "position": [
        672,
        176
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.action }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "rightValue": "request"
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "d90a478d-e573-4f40-927f-3c71abf18768",
      "name": "Create Reset Code",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        896,
        80
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH s AS (SELECT id, email, telegram_chat_id FROM staff WHERE active IS NOT FALSE AND (lower(username) = lower($1) OR phone = $1) LIMIT 1), recent AS (SELECT count(*) AS c FROM staff_reset_codes r JOIN s ON r.staff_id = s.id WHERE r.created_at > now() - interval '15 minutes'), ins AS (INSERT INTO staff_reset_codes (staff_id, code_hash, expires_at) SELECT s.id, encode(sha256(convert_to($2 || ':' || s.id, 'UTF8')), 'hex'), now() + interval '10 minutes' FROM s, recent WHERE recent.c < 3 RETURNING staff_id) SELECT (SELECT staff_id FROM ins) AS staff_id, (SELECT email FROM s) AS email, (SELECT telegram_chat_id FROM s) AS tg",
        "options": {
          "queryReplacement": "={{ [ $json.identifier, $json.code ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "2k1Ti2SitOd5gAN3",
          "name": "Postgres account"
        }
      }
    },
    {
      "id": "edf877e7-ee7c-4fcb-8567-15c0cd7ddbc7",
      "name": "Code Created?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1120,
        80
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.staff_id }}",
              "operator": {
                "type": "number",
                "operation": "gt"
              },
              "rightValue": 0
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "c5e8d12b-3b26-4b06-bac6-758a9880b91f",
      "name": "Send Code Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1344,
        0
      ],
      "parameters": {
        "resource": "message",
