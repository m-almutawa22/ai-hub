{
  "id": "6GS8LuZfPagnyreB",
  "name": "Almutawa - Staff Password Reset (one-time code)",
  "description": "Forgot-password flow for staff: sends a one-time 6-digit code (valid 10 minutes, max 3 requests per 15 minutes, 5 attempts) to the staff member's Telegram and email, then verifies it and sets the new password.",
  "active": true,
  "activeVersionId": "33687548-8fd2-4d5a-b803-4303318f784b",
  "createdAt": "2026-10-04T18:07:22.871Z",
  "updatedAt": "2026-10-04T18:07:26.208Z",
  "isArchived": false,
  "versionId": "33687548-8fd2-4d5a-b803-4303318f784b",
  "versionCounter": 2,
  "sourceWorkflowId": null,
  "triggerCount": 1,
  "nodes": [
    {
      "id": "babc74b9-8296-4a85-b272-39f524b559b3",
      "name": "Staff Reset API",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        272
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "staff-reset",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "webhookId": "7b325ce7-3909-4d39-905b-32199cd6105a"
    },
    {
      "id": "1395ae0e-c33b-4c11-b02a-61aade0ce884",
      "name": "Prepare",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        272
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const b = $input.first().json.body || {};\nconst action = b.action === 'verify' ? 'verify' : 'request';\nconst identifier = String(b.identifier || '').trim().slice(0, 80);\nlet code = String(b.code || '').replace(/\\D/g, '').slice(0, 6);\nconst pw = String(b.newPassword || '');\nif (action === 'request') { code = String(Math.floor(100000 + Math.random() * 900000)); }\nconst valid = identifier.length > 1 && (action === 'request' || (code.length === 6 && pw.length >= 8 && pw.length <= 200));\nreturn [{ json: { action: action, identifier: identifier, code: code, pw: pw, valid: valid } }];"
      }
    },
    {
      "id": "cf0fa1ee-a2ce-4d31-b942-057aa689ccc0",
      "name": "Valid Input?",
      "type": "n8n-nodes-base.if",
