    {
      "id": "4fe5f9c4-d084-492f-bfb6-fdaffab5c331",
      "name": "Verify And Reset",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        896,
        272
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH s AS (SELECT id FROM staff WHERE active IS NOT FALSE AND (lower(username) = lower($1) OR phone = $1) LIMIT 1), c AS (SELECT r.id FROM staff_reset_codes r JOIN s ON r.staff_id = s.id WHERE r.used_at IS NULL AND r.expires_at > now() AND r.attempts < 5 ORDER BY r.id DESC LIMIT 1), bump AS (UPDATE staff_reset_codes SET attempts = attempts + 1 WHERE id = (SELECT id FROM c) RETURNING id, code_hash, staff_id), ok AS (SELECT b.id, b.staff_id FROM bump b WHERE b.code_hash = encode(sha256(convert_to($2 || ':' || b.staff_id, 'UTF8')), 'hex')), used AS (UPDATE staff_reset_codes SET used_at = now() WHERE id = (SELECT id FROM ok) RETURNING id), pw AS (SELECT md5(random()::text || clock_timestamp()::text) AS salt), upd AS (UPDATE staff st SET password_hash = encode(sha256(convert_to($3 || ':' || pw.salt, 'UTF8')), 'hex'), password_salt = pw.salt FROM pw WHERE st.id = (SELECT staff_id FROM ok) RETURNING st.id), lg AS (INSERT INTO audit_log (actor_type, actor_id, action, entity, entity_id, workflow) SELECT 'staff', id::text, 'password_reset', 'staff', id::text, 'Staff Password Reset' FROM upd) SELECT (SELECT count(*) FROM upd)::int AS reset",
        "options": {
          "queryReplacement": "={{ [ $json.identifier, $json.code, $json.pw ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "2k1Ti2SitOd5gAN3",
          "name": "Postgres account"
        }
      }
    },
