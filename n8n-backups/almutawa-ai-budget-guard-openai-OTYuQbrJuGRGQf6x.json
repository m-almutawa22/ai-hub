{
  "id": "OTYuQbrJuGRGQf6x",
  "name": "Almutawa - AI Budget Guard (OpenAI)",
  "description": "Every 3 hours: reads month-to-date OpenAI spend via the Costs API (admin key), converts to BHD, and sends a one-time Telegram alert to Mohamed at 50/80/100% of the 10 BHD monthly budget.",
  "active": false,
  "activeVersionId": null,
  "createdAt": "2026-10-03T10:52:56.633Z",
  "updatedAt": "2026-10-03T10:53:00.208Z",
  "isArchived": false,
  "versionId": "344ccccd-0360-45aa-83cc-5ce7ddc34fe6",
  "versionCounter": 2,
  "sourceWorkflowId": null,
  "triggerCount": 0,
  "nodes": [
    {
      "id": "b940dd78-872a-46ff-a81a-0f19e59251e9",
      "name": "Every 3 Hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 3
            }
          ]
        }
      }
    },
    {
      "id": "5374827b-0ffa-4fb5-9a47-c8a7cd20ad70",
      "name": "Ensure Budget Alerts Table",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        224,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "CREATE TABLE IF NOT EXISTS budget_alerts (month text NOT NULL, scope text NOT NULL DEFAULT 'openai', threshold int NOT NULL, spent_bhd numeric, sent_at timestamptz DEFAULT now(), PRIMARY KEY (month, scope, threshold)); SELECT 1 AS ok;",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "2k1Ti2SitOd5gAN3",
          "name": "Postgres account"
        }
      }
    },
    {
      "id": "3740a11d-be25-4dd4-9f44-856610ad908e",
      "name": "Get OpenAI Month Costs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        448,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "https://api.openai.com/v1/organization/costs",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpTemplatedCustomAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "start_time",
              "value": "={{ Math.floor($now.setZone(\"Asia/Bahrain\").startOf(\"month\").toSeconds()) }}"
            },
            {
              "name": "bucket_width",
              "value": "1d"
            },
            {
              "name": "limit",
              "value": "31"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "executeOnce": true
    },
    {
      "id": "8b11e9cc-b2e4-4db4-90a3-bfdcefbc6d08",
      "name": "Compute Budget Status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const BUDGET_BHD = 10;\nconst USD_TO_BHD = 0.376;\nconst res = $input.first().json || {};\nlet usd = 0;\n(res.data || []).forEach(function (b) { (b.results || []).forEach(function (r) { usd += Number((r.amount && r.amount.value) || 0); }); });\nconst bhd = Math.round(usd * USD_TO_BHD * 1000) / 1000;\nconst pct = Math.round((bhd / BUDGET_BHD) * 1000) / 10;\nconst crossed = [50, 80, 100].filter(function (t) { return pct >= t; });\nconst month = $now.setZone('Asia/Bahrain').toFormat('yyyy-MM');\nreturn [{ json: { month: month, usd: Math.round(usd * 100) / 100, bhd: bhd, pct: pct, budget: BUDGET_BHD, crossedLiteral: '{' + crossed.join(',') + '}' } }];"
      }
    },
    {
      "id": "ba7b0fac-3e34-4b97-831d-1549d0bbc587",
      "name": "Record New Threshold",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        896,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH ins AS (INSERT INTO budget_alerts (month, scope, threshold, spent_bhd) SELECT $1, 'openai', t, $2::numeric FROM unnest($3::int[]) AS t ON CONFLICT DO NOTHING RETURNING threshold) SELECT max(threshold) AS new_threshold FROM ins;",
        "options": {
          "queryReplacement": "={{ [$json.month, $json.bhd, $json.crossedLiteral] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "2k1Ti2SitOd5gAN3",
          "name": "Postgres account"
        }
      }
    },
    {
      "id": "1ae90a08-226a-4007-b79d-11280bc06600",
      "name": "New Threshold Crossed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1120,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.new_threshold }}",
              "operator": {
                "type": "number",
                "operation": "gte"
              },
              "rightValue": 50
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "b2e953e2-2bce-46fc-82f6-48153431cd04",
      "name": "Alert Mohamed on Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1344,
        0
      ],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "8132574840",
        "text": "={{ $json.new_threshold >= 100 ? \"🔴\" : \"⚠️\" }} تنبيه ميزانية الذكاء الاصطناعي\n\nاستهلاك OpenAI هذا الشهر: {{ $(\"Compute Budget Status\").item.json.bhd }} د.ب من {{ $(\"Compute Budget Status\").item.json.budget }} د.ب ({{ $(\"Compute Budget Status\").item.json.pct }}%)\nتم تجاوز حد {{ $json.new_threshold }}%.\n\n{{ $json.new_threshold >= 100 ? \"بلغنا السقف. ما راح يرتفع تلقائياً. قرر: رفع الميزانية أو إيقاف المهام غير الضرورية.\" : \"للعلم فقط، ما يحتاج أي إجراء الحين.\" }}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "QfQTvpw3XcVYjBNy",
          "name": "Telegram account"
        }
      },
      "webhookId": "5d1020c3-5991-46b7-8f45-d7bc4cf56a40"
    }
  ],
