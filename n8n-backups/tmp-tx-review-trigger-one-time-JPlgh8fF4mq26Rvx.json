      "parameters": {
        "operation": "executeQuery",
        "query": "CREATE OR REPLACE FUNCTION trg_tx_review_decided() RETURNS trigger AS $f$ BEGIN IF NEW.request_type = 'tx_review' AND NEW.status IN ('approved','rejected') AND OLD.status = 'pending' THEN UPDATE finance_transactions SET status = CASE WHEN NEW.status = 'approved' THEN 'confirmed' ELSE 'ignored' END, note = COALESCE(NEW.decision_note, note), reviewed_at = now() WHERE id::text = NEW.details->>'tx_id' AND status = 'needs_review'; END IF; RETURN NEW; END $f$ LANGUAGE plpgsql; DROP TRIGGER IF EXISTS tx_review_decided ON approvals; CREATE TRIGGER tx_review_decided AFTER UPDATE ON approvals FOR EACH ROW EXECUTE FUNCTION trg_tx_review_decided(); SELECT 'ok' AS status;"
      },
