    {
      "id": "9bd30c20-8bff-4c39-9352-9ef460009130",
      "name": "Assemble List",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1792,
        0
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const trips = $('Build Booking Filter').first().json.trips;\nconst bookings = $('Get Bookings').first().json.records || [];\nconst travelers = $('Get Travelers').first().json.records || [];\nconst customers = $('Get Customers').first().json.records || [];\nconst cmap = {}; customers.forEach(c => cmap[c.id] = c.fields || {});\nconst tmap = {}; travelers.forEach(t => tmap[t.id] = t.fields || {});\nconst rows = []; let missing = 0;\nbookings.forEach(b => { const f = b.fields || {}; const cust = cmap[(f.Customer || [])[0]] || {}; const tids = f.Travelers || [];\n  tids.forEach(id => { const t = tmap[id] || {}; rows.push({ title: t.Title || '', name: t['Full Name'] || '', passport: t['Passport Number'] || '', nationality: t.Nationality || '', dob: t['Date of Birth'] || '', role: t.Role || '', has_passport_photo: !!(t['Passport Photo'] || []).length, booking: f['Booking Reference'] || ('#' + (f['Booking ID'] || '')), lead: cust['Full Name'] || '', phone: cust.Phone || '', payment: f['Payment Status'] || '', booking_status: f['Booking Status'] || '' }); });\n  missing += Math.max((f['Number of Travelers'] || (tids.length ? 0 : 1)) - tids.length, 0);\n});\nrows.sort((a, b) => (a.booking + a.name).localeCompare(b.booking + b.name));\nrows.forEach((r, i) => r.n = i + 1);\nreturn [{ json: { matched_trips: trips, bookings: bookings.length, travelers_listed: rows.length, travelers_missing_details: missing, travelers: rows, note: trips.length > 1 ? 'More than one trip matched; ask which one if unclear.' : (trips.length ? '' : 'No trip matched. Try the departure date YYYY-MM-DD or the package number.') } }];"
      }
    }
  ],
