    {
      "id": "945085b1-912d-4155-b73c-c40b4eb9c7ea",
      "name": "Build Trip Filter",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const t = String($input.first().json.trip || '').trim().replace(/'/g, \"\\\\'\");\nconst f = t ? \"OR(FIND(LOWER('\" + t + \"'), LOWER({Title})), DATETIME_FORMAT({Departure Date}, 'YYYY-MM-DD') = '\" + t + \"', {Package ID} & '' = '\" + t + \"')\" : 'FALSE()';\nreturn [{ json: { trip: t, f } }];"
      }
    },
    {
      "id": "32b85f38-fee4-4a5d-bd73-b95146e17aad",
      "name": "Get Trips",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        448,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "https://api.airtable.com/v0/appPB4D3VkkSJKjRK/tblbCLAD8HLLwA9R7",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "airtableTokenApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "filterByFormula",
              "value": "={{ $json.f }}"
            },
            {
              "name": "maxRecords",
              "value": "6"
            },
            {
              "name": "sort[0][field]",
              "value": "Departure Date"
            },
            {
              "name": "sort[0][direction]",
              "value": "desc"
            }
          ]
        },
        "options": {}
      },
      "credentials": {
        "airtableTokenApi": {
          "id": "dJPlPtRxY8Txd9y9",
          "name": "Airtable Personal Access Token account"
        }
      }
    },
    {
      "id": "e0e62495-9bbc-4d80-966b-ea2b2e63afc0",
      "name": "Build Booking Filter",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const recs = $input.first().json.records || [];\nconst ids = [];\nrecs.forEach(r => (r.fields.Bookings || []).forEach(b => ids.push(b)));\nconst f = ids.length ? 'OR(' + ids.map(i => \"RECORD_ID()='\" + i + \"'\").join(',') + ')' : 'FALSE()';\nreturn [{ json: { trips: recs.map(r => ({ id: r.fields['Package ID'], title: r.fields.Title, departure: r.fields['Departure Date'], return: r.fields['Return Date'], status: r.fields.Status, seats_left: r.fields['Seats Available'], bookings: (r.fields.Bookings || []).length })), f } }];"
      }
    },
    {
      "id": "b4dbf4d0-8e29-4dcc-baf2-5dad112ab3c1",
      "name": "Get Bookings",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        896,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "https://api.airtable.com/v0/appPB4D3VkkSJKjRK/tblZ6AQCBmEY2KYHr",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "airtableTokenApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "filterByFormula",
              "value": "={{ $json.f }}"
            },
            {
              "name": "pageSize",
              "value": "100"
            }
          ]
        },
        "options": {}
      },
      "credentials": {
        "airtableTokenApi": {
          "id": "dJPlPtRxY8Txd9y9",
          "name": "Airtable Personal Access Token account"
        }
      }
    },
    {
      "id": "70d2e7e5-1043-4ba7-bf59-e4c1d46a8e01",
      "name": "Build Traveler Filter",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        0
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const recs = $input.first().json.records || [];\nconst tids = [], cids = [];\nrecs.forEach(r => { (r.fields.Travelers || []).forEach(x => tids.push(x)); (r.fields.Customer || []).forEach(x => cids.push(x)); });\nconst mk = a => a.length ? 'OR(' + a.map(i => \"RECORD_ID()='\" + i + \"'\").join(',') + ')' : 'FALSE()';\nreturn [{ json: { tf: mk(tids), cf: mk([...new Set(cids)]) } }];"
      }
    },
    {
      "id": "a3d44f78-f683-45a4-97c0-5c74345fabcb",
      "name": "Get Travelers",
