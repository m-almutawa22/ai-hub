        "url": "https://api.airtable.com/v0/appPB4D3VkkSJKjRK/tblMaJFE8yIqxFj1N",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "airtableTokenApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "filterByFormula",
              "value": "={{ $json.tf }}"
