      "name": "Get Customers",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1568,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "https://api.airtable.com/v0/appPB4D3VkkSJKjRK/tblm8JWYMAoamikUz",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "airtableTokenApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "filterByFormula",
              "value": "={{ $('Build Traveler Filter').first().json.cf }}"
            },
