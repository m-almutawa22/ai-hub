      "parameters": {
        "operation": "executeQuery",
        "query": "CREATE TABLE IF NOT EXISTS notifications (id serial PRIMARY KEY, created_at timestamptz NOT NULL DEFAULT now(), category text NOT NULL DEFAULT 'system', title text NOT NULL, body text, priority text NOT NULL DEFAULT 'normal' CHECK (priority IN ('low','normal','high','urgent')), entity text, entity_id text, source text, read_at timestamptz); CREATE INDEX IF NOT EXISTS notifications_unread_idx ON notifications (read_at) WHERE read_at IS NULL; INSERT INTO notifications (category, title, body, priority, source) SELECT 'system', 'مرحباً بصندوق الإشعارات', 'من الحين كل تنبيهات النظام والموافقات توصل هنا. اضغط على أي إشعار عشان تناقشه مع الوكيل.', 'normal', 'setup' WHERE NOT EXISTS (SELECT 1 FROM notifications); SELECT count(*)::int AS notifications FROM notifications;"
