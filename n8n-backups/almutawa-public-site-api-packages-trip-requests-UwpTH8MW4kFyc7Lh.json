    {
      "id": "bbf5505e-ba0a-417a-8ed3-fdc288c6d88d",
      "name": "Get Visible Packages",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        224,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, title, destination, price, COALESCE(currency,'BHD') AS currency, seats_available, to_char(departure_date,'YYYY-MM-DD') AS departure_date, to_char(return_date,'YYYY-MM-DD') AS return_date, duration_days, transport_type, package_type, includes_visa, description, image_url, region FROM packages WHERE is_visible = true AND COALESCE(status,'Active') = 'Active' AND (departure_date IS NULL OR departure_date >= current_date) ORDER BY departure_date NULLS LAST, id LIMIT 60;",
        "options": {
          "largeNumbersOutput": "numbers"
        }
      },
      "credentials": {
        "postgres": {
          "id": "2k1Ti2SitOd5gAN3",
          "name": "Postgres account"
        }
      },
      "alwaysOutputData": true
    },
    {
      "id": "31117b50-34af-4876-bb9d-d1419601b598",
      "name": "Shape Packages",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const out = $input.all().map(i => i.json).filter(p => p && p.id).map(p => ({\n  id: p.id,\n  title: p.title || '',\n  destination: p.destination || '',\n  price: p.price != null ? Number(p.price) : null,\n  currency: p.currency || 'BHD',\n  seats: p.seats_available,\n  departure: p.departure_date,\n  return: p.return_date,\n  days: p.duration_days,\n  transport: p.transport_type || '',\n  type: p.package_type || '',\n  visa: !!p.includes_visa,\n  description: String(p.description || '').slice(0, 600),\n  image: p.image_url || '',\n  region: p.region || ''\n}));\nreturn [{ json: { success: true, packages: out } }];"
      }
    },
    {
      "id": "9aecde39-a784-44dd-aa13-e1ebc8dc5862",
      "name": "Respond Packages",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        672,
        0
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Cache-Control",
                "value": "public, max-age=120"
              }
            ]
          }
        }
      }
    },
    {
      "id": "d09e329f-7f02-45c1-8fde-16884f8dd43e",
      "name": "Trip Request Hook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        320
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "trip-request",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "webhookId": "94966ea5-f91f-4653-8b5d-6f9690980864"
    },
    {
      "id": "00a61853-8f12-428a-8e3e-643603630a2c",
      "name": "Validate Trip Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        320
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const b = ($input.first().json.body) || {};\nconst s = (v, n) => String(v == null ? '' : v).replace(/[<>]/g, '').trim().slice(0, n || 200);\nconst d = v => /^\\d{4}-\\d{2}-\\d{2}$/.test(String(v || '')) ? String(v) : '';\nconst phone = s(b.phone, 20).replace(/[^0-9+]/g, '');\nconst email = s(b.email, 120);\nconst errors = [];\nif (s(b.website)) errors.push('spam');\nif (!s(b.name)) errors.push('name');\nif (phone.replace(/\\D/g, '').length < 8 && !/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(email)) errors.push('contact');\nif (!s(b.to)) errors.push('to');\nconst services = Array.isArray(b.services) ? b.services.map(x => s(x, 40)).filter(Boolean).slice(0, 10) : [];\nconst ref = 'TR-' + Date.now().toString(36).toUpperCase().slice(-5) + Math.floor(Math.random() * 90 + 10);\nreturn [{ json: { valid: errors.length === 0, errors, ref, name: s(b.name, 120), phone, email, from: s(b.from, 120), to: s(b.to, 120), depart: d(b.depart), ret: d(b.return), adults: Math.max(0, Math.min(50, parseInt(b.adults, 10) || 1)), children: Math.max(0, Math.min(50, parseInt(b.children, 10) || 0)), services, budget: s(b.budget, 80), notes: s(b.notes, 1500), lang: b.lang === 'en' ? 'en' : 'ar' } }];"
      }
    },
    {
      "id": "77ff8ce5-6c21-4272-80de-7dad4265f288",
      "name": "Is Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        448,
        320
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.valid }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              },
              "rightValue": ""
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "06899fcc-bc7a-4797-b3e2-8eb457b9f427",
      "name": "Save Trip Request",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        672,
        224
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO trip_requests (ref, full_name, phone, email, from_place, to_place, depart_date, return_date, adults, children, services, budget, notes, lang) VALUES ($1, $2, NULLIF($3,''), NULLIF($4,''), NULLIF($5,''), $6, NULLIF($7,'')::date, NULLIF($8,'')::date, $9::int, $10::int, string_to_array(NULLIF($11,''), '|'), NULLIF($12,''), NULLIF($13,''), $14) RETURNING id, ref;",
        "options": {
          "queryReplacement": "={{ [ $json.ref, $json.name, $json.phone, $json.email, $json.from, $json.to, $json.depart, $json.ret, String($json.adults), String($json.children), $json.services.join('|'), $json.budget, $json.notes, $json.lang ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "2k1Ti2SitOd5gAN3",
          "name": "Postgres account"
        }
      }
    },
