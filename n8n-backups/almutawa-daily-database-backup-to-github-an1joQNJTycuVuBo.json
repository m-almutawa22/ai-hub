    {
      "id": "56621272-bebb-46fa-b59f-95dd9fcf4e58",
      "name": "Build Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1792,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const all = $('Build Backup Files').all().map(i => i.json);\nconst done = all.filter(x => !x.skipped);\nconst skipped = all.filter(x => x.skipped);\nconst totalRows = done.reduce((s, x) => s + (x.rows > 0 ? x.rows : 0), 0);\nlet body = 'تم نسخ ' + done.length + ' جدول (' + totalRows + ' سجل) إلى GitHub: ai-hub/db-backups';\nif (skipped.length) body += '\\n⚠️ جداول كبيرة ما انحفظت: ' + skipped.map(x => x.table + ' (' + x.sizeMB + 'MB)').join('، ');\nreturn [{ json: { title: skipped.length ? '⚠️ نسخة قاعدة البيانات اكتملت مع ملاحظات' : '✅ نسخة قاعدة البيانات اليومية اكتملت', body, priority: skipped.length ? 'normal' : 'low' } }];"
      },
      "executeOnce": true
    },
