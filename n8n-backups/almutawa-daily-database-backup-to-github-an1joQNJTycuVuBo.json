{
  "id": "an1joQNJTycuVuBo",
  "name": "Almutawa - Daily Database Backup to GitHub",
  "description": "Daily 3:30 AM: dumps every public Postgres table (except otp_codes) to JSON, redacts secret-like strings, and commits one file per table to GitHub m-almutawa22/ai-hub under db-backups/ (git history keeps daily versions). Posts a low-priority inbox note.",
  "active": false,
