    {
      "id": "754b1603-b83b-4a8f-a304-bbdf0ae45571",
      "name": "Ensure Dump Function",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        224,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "CREATE OR REPLACE FUNCTION public.backup_dump(tbl text) RETURNS json LANGUAGE plpgsql AS $fn$ DECLARE r json; BEGIN EXECUTE format('SELECT coalesce(json_agg(t), ''[]''::json) FROM public.%I t', tbl) INTO r; RETURN r; END $fn$;",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "2k1Ti2SitOd5gAN3",
          "name": "Postgres account"
        }
      }
    },
    {
      "id": "1755e690-bc4d-467f-9ef4-d3a8a8fbe2c2",
      "name": "Dump All Tables",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        448,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT table_name, public.backup_dump(table_name)::text AS data FROM information_schema.tables WHERE table_schema = 'public' AND table_type = 'BASE TABLE' AND table_name NOT IN ('otp_codes') ORDER BY table_name;",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "2k1Ti2SitOd5gAN3",
          "name": "Postgres account"
        }
      },
      "executeOnce": true
    },
    {
      "id": "d82117e4-8302-4753-b8f3-4c490dba7329",
      "name": "Build Backup Files",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const day = new Date().toISOString().slice(0, 10);\nconst out = [];\nfor (const it of $input.all()) {\n  const t = it.json.table_name;\n  let raw = it.json.data || '[]';\n  let rows = 0;\n  try { rows = JSON.parse(raw).length; } catch (e) { rows = -1; }\n  raw = raw.replace(/AC[a-f0-9]{32}/gi, '[REDACTED_TWILIO_SID]')\n    .replace(/SK[a-f0-9]{32}/gi, '[REDACTED_TWILIO_KEY]')\n    .replace(/sk-[A-Za-z0-9_-]{20,}/g, '[REDACTED_API_KEY]')\n    .replace(/pat[A-Za-z0-9]{14}\\.[A-Za-z0-9]{40,}/g, '[REDACTED_AIRTABLE_TOKEN]')\n    .replace(/gh[pousr]_[A-Za-z0-9]{30,}/g, '[REDACTED_GITHUB_TOKEN]')\n    .replace(/xox[abposr]-[A-Za-z0-9-]{10,}/g, '[REDACTED_SLACK_TOKEN]');\n  const sizeMB = Buffer.byteLength(raw, 'utf8') / 1048576;\n  if (sizeMB > 45) { out.push({ json: { table: t, rows, skipped: true, sizeMB: sizeMB.toFixed(1) } }); continue; }\n  let parsed = [];\n  try { parsed = JSON.parse(raw); } catch (e) { parsed = raw; }\n  const content = JSON.stringify({ table: t, backup_date: day, rows, data: parsed }, null, 1);\n  out.push({ json: { table: t, rows, skipped: false, filePath: 'db-backups/' + t + '.json', fileContent: content, commitMessage: 'DB backup ' + t + ' (' + rows + ' rows) ' + day } });\n}\nreturn out;"
      }
    },
    {
